      <column caption='Properties by category' datatype='string' name='[Calculation_0643813936766977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer reviews' datatype='string' name='[Calculation_0643813937840130]' role='dimension' type='nominal'>
